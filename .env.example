# ─────────────────────────────────────────────────────────────────────────────
# Travel App — environment template
# Only indie-accessible APIs listed. Keys marked [REQUIRED] are minimum to run.
# Enterprise APIs (Sabre, Travelport, Hotelbeds, Trainline, etc.) intentionally
# omitted — they require B2B contracts.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core: AI + Maps ────────────────────────────────────────────────────────
VITE_GEMINI_API_KEY=                    # [REQUIRED] https://aistudio.google.com/apikey
VITE_MAPS_API_KEY=                      # [REQUIRED] Google Maps JS + Places

# ── Firebase (client) ──────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=                  # [REQUIRED]
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=                # for FCM web push

# ── Server-side keys (set via `firebase functions:config:set` or params) ───
# These are referenced in functions/src/index.ts via defineString()

# Flights & hotels
DUFFEL_API_TOKEN=                       # https://duffel.com — free test mode
AMADEUS_CLIENT_ID=                      # https://developers.amadeus.com — free tier
AMADEUS_CLIENT_SECRET=
TRAVELPAYOUTS_API_TOKEN=                # https://www.travelpayouts.com — affiliate, free
TRAVELPAYOUTS_MARKER=                   # your affiliate marker
MAKCORPS_API_KEY=                       # https://makcorps.com — free tier hotel price compare

# Transit
NAVITIA_API_KEY=                        # https://navitia.io — free key

# POI / Places
GEOAPIFY_API_KEY=                       # https://www.geoapify.com — 3000/day free
OPENTRIPMAP_API_KEY=                    # https://opentripmap.io — free key
FOURSQUARE_API_KEY=                     # https://foursquare.com/developers — free tier

# Weather / Air quality (Open-Meteo needs no key)
AQICN_API_TOKEN=                        # https://aqicn.org/data-platform/token — free

# Travel intel
VISADB_API_KEY=                         # https://visadb.io — free tier
# REST Countries: no key (https://restcountries.com)
# Nager.Date: no key (https://date.nager.at)
# Frankfurter: no key (https://www.frankfurter.app)
# Wikivoyage: no key (MediaWiki API)

# Carbon
CLIMATIQ_API_KEY=                       # https://www.climatiq.io — free tier

# eSIM (apply for partner key)
AIRALO_CLIENT_ID=                       # https://airalopartners.airalo.com
AIRALO_CLIENT_SECRET=

# Photos
UNSPLASH_ACCESS_KEY=                    # https://unsplash.com/developers — 50/hr free
PEXELS_API_KEY=                         # https://www.pexels.com/api — 200/hr free

# Events / venues
TICKETMASTER_API_KEY=                   # https://developer-acct.ticketmaster.com — 5k/day

# Email parser
GMAIL_OAUTH_CLIENT_ID=                  # Google Cloud OAuth Web app (server-side, unused now)
GMAIL_OAUTH_CLIENT_SECRET=
VITE_GMAIL_OAUTH_CLIENT_ID=             # Same client_id but exposed to client for Google Identity Services

# Reddit / YouTube (for travel intelligence)
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Notifications (optional)
TWILIO_SID=
TWILIO_TOKEN=
TELEGRAM_BOT_TOKEN=
