rules_version = '2';

// Atlas Storage rules.
// vault/   = client-encrypted blobs, per-uid
// journal/ = trip-journal photos, per-uid

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Encrypted document vault
    match /vault/{uid}/{docId} {
      allow read, write: if isOwner(uid)
                         && request.resource.size < 25 * 1024 * 1024; // 25 MB cap
    }

    // Trip journal photos
    match /journal/{uid}/{tripId}/{entryId}/{filename} {
      allow read, write: if isOwner(uid)
                         && request.resource.size < 15 * 1024 * 1024
                         && request.resource.contentType.matches('image/.*');
    }

    // Profile avatars (optional)
    match /avatars/{uid}/{filename} {
      allow read: if true;
      allow write: if isOwner(uid)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
